# Google Apps Script web app URL that the newsletter signup form (NewsletterCTA) POSTs to.
# Required for the newsletter form to work; without it, signups fail with "Signup endpoint is not configured."
# Must also be set as a repository secret of the same name for the GitHub Pages deploy workflow
# (.github/workflows/deploy.yml) to pick it up at build time.
PUBLIC_APPS_SCRIPT_NEWSLETTER_URL=

# Commit hash shown in the footer. Populated automatically by build.ts at build time — do not set manually.
# PUBLIC_GIT_SHA=
